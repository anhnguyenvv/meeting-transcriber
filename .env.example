# ════════════════════════════════════════════════════════
#  File này được setup_wizard.py tạo tự động.
#  Bạn cũng có thể chỉnh tay nếu muốn.
# ════════════════════════════════════════════════════════

# [TÙY CHỌN] HuggingFace token — chỉ cần khi bật "phân tách người nói"
# Lấy miễn phí tại: https://huggingface.co/settings/tokens
# Nếu để trống, app vẫn chạy bình thường (không có nhãn Speaker 1/2)
HF_TOKEN=

# ── Chọn kích thước model theo máy của bạn ───────────────
#
#  RAM 4-6 GB  →  OLLAMA_MODEL=qwen2.5:1.5b   WHISPER_MODEL=small
#  RAM 8 GB    →  OLLAMA_MODEL=qwen2.5:3b      WHISPER_MODEL=small   ← MẶC ĐỊNH
#  RAM 16+ GB  →  OLLAMA_MODEL=qwen2.5:7b-instruct  WHISPER_MODEL=medium
#
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small

# Địa chỉ Ollama (không cần thay đổi nếu chạy local)
OLLAMA_BASE_URL=http://localhost:11434

# ── Live transcription ─────────────────────────────────────
# Thời lượng mỗi chunk audio gửi cho Whisper (giây)
# Nhỏ hơn = cập nhật nhanh hơn nhưng kém chính xác
# LIVE_CHUNK_S=5
# LIVE_OVERLAP_S=1.5
# LIVE_SILENCE_THRESHOLD=0.01

# ── Multilingual / code-switching ──────────────────────────
# Chia file thành chunk N giây, detect ngôn ngữ riêng từng chunk
# Giúp cuộc họp trộn JA/EN/VI chính xác hơn
# MULTILINGUAL_CHUNK_S=30

